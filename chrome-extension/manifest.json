{
  "manifest_version": 3,
  "name": "pwman",
  "version": "1.0.0",
  "description": "Autofill credentials from your local encrypted pwman vault.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "pwman"
  },
  "permissions": ["nativeMessaging", "activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
